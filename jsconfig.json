{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable", "webworker"],
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/core/**/*.js", "js/core/**/*.d.ts", "js/types.d.ts", "js/pure.js"]
}
